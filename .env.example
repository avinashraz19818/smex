# ===== Pehli baar setup: sirf ye 4 cheezein chahiye =====
# Baaki SAB kuch bot ke andar se ho jayega (/login, /addwingo, /seturl ...).
# Neeche wali session lines khaali chhodo — bot khud bharega.

BOT_TOKEN=YOUR_BOT_TOKEN_HERE

API_ID=1234567
API_HASH=abcdef1234567890abcdef

# Kaun owner add kar sakta hai jab koi owner na ho (apna Telegram numeric ID).
# Pehle se owners hain to ye optional hai.
SUPERADMIN_ID=

HEADLESS=true

# --- Neeche sab bot khud bharega, haath se mat chhedo ---
# (owner slot: /login owner | client slot: /login client1 ... client6)

OWNER_1_SESSION=
OWNER_2_SESSION=

CLIENT_1_SESSION=
CLIENT_2_SESSION=
CLIENT_3_SESSION=
CLIENT_4_SESSION=
CLIENT_5_SESSION=
CLIENT_6_SESSION=

# Naye owners ke session bot khud banayega: OWNER_<telegramid>_SESSION

# Emoji: /setemoji se set karo (ya /emojiid se ID nikaal ke)
TICK_EMOJI=
MONEY_EMOJI=
CROWN_EMOJI=
FIRE_EMOJI=
