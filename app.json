{
  "name": "smex-wingo-bot",
  "description": "SMEX Telegram and Wingo automation bot",
  "repository": "https://github.com/avinashraz19818/smex",
  "keywords": ["python", "telegram", "playwright", "worker"],
  "stack": "heroku-22",
  "buildpacks": [
    {
      "url": "https://github.com/mxschmitt/heroku-playwright-buildpack.git"
    },
    {
      "url": "heroku/python"
    }
  ],
  "env": {
    "BOT_TOKEN": {
      "description": "Telegram bot token from BotFather",
      "required": true,
      "value": ""
    },
    "API_ID": {
      "description": "Telegram API ID",
      "required": true,
      "value": ""
    },
    "API_HASH": {
      "description": "Telegram API hash",
      "required": true,
      "value": ""
    },
    "SUPERADMIN_ID": {
      "description": "Optional Telegram numeric ID allowed to configure the bot",
      "required": false,
      "value": ""
    },
    "HEADLESS": {
      "description": "Run Playwright browsers headless",
      "required": false,
      "value": "true"
    },
    "Zayro_1_SESSION": {
      "description": "Telegram owner session string used by the existing config",
      "required": false,
      "value": ""
    },
    "OWNER_2_SESSION": {
      "description": "Optional second owner Telegram session string",
      "required": false,
      "value": ""
    },
    "CLIENT_1_SESSION": {
      "description": "Telegram client session 1",
      "required": false,
      "value": ""
    },
    "CLIENT_2_SESSION": {
      "description": "Telegram client session 2",
      "required": false,
      "value": ""
    },
    "CLIENT_3_SESSION": {
      "description": "Telegram client session 3",
      "required": false,
      "value": ""
    },
    "CLIENT_4_SESSION": {
      "description": "Telegram client session 4",
      "required": false,
      "value": ""
    },
    "CLIENT_5_SESSION": {
      "description": "Telegram client session 5",
      "required": false,
      "value": ""
    },
    "CLIENT_6_SESSION": {
      "description": "Telegram client session 6",
      "required": false,
      "value": ""
    },
    "TICK_EMOJI": {
      "description": "Optional Telegram custom emoji ID",
      "required": false,
      "value": ""
    },
    "MONEY_EMOJI": {
      "description": "Optional Telegram custom emoji ID",
      "required": false,
      "value": ""
    },
    "CROWN_EMOJI": {
      "description": "Optional Telegram custom emoji ID",
      "required": false,
      "value": ""
    },
    "FIRE_EMOJI": {
      "description": "Optional Telegram custom emoji ID",
      "required": false,
      "value": ""
    },
    "PLAYWRIGHT_BUILDPACK_BROWSERS": {
      "description": "Only install Chromium to keep the Heroku slug smaller",
      "required": false,
      "value": "chromium"
    }
  },
  "formation": {
    "worker": {
      "quantity": 1,
      "size": "basic"
    }
  }
}
